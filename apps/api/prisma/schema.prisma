generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  CLIENT
  PRESTATAIRE
  ADMIN
  SUPPORT
}

enum VenueType {
  SALLE
  JARDIN
  RESTAURANT
  BOITE_DE_NUIT
  PARC
  ESPACE_PUBLIC
  AUTRE
}

enum ReservationStatus {
  EN_ATTENTE
  CONFIRMEE
  ANNULEE
  TERMINEE
  REMBOURSEE
}

enum PaymentMethod {
  CARTE_BANCAIRE
  MOBILE_MONEY
  VIREMENT
}

enum PaymentStatus {
  EN_ATTENTE
  REUSSI
  ECHOUE
  REMBOURSE
}

enum NotificationType {
  CONFIRMATION
  RAPPEL
  PAIEMENT
  MESSAGE
  ANNULATION
  AVIS
}

// ─── Modèles ─────────────────────────────────────────────

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  role        Role     @default(CLIENT)
  firstName   String
  lastName    String
  phone       String?
  avatar      String?
  isVerified  Boolean  @default(false)
  otpCode     String?
  otpExpiry   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venues        Venue[]
  services      Service[]
  reservations  Reservation[]
  reviews       Review[]
  sentMessages  Message[]      @relation("SentMessages")
  recvMessages  Message[]      @relation("ReceivedMessages")
  notifications Notification[]

  @@map("users")
}

model Venue {
  id          Int       @id @default(autoincrement())
  ownerId     Int
  name        String
  description String    @db.Text
  type        VenueType
  capacity    Int
  pricePerHour Decimal  @db.Decimal(10, 2)
  city        String
  address     String
  lat         Float?
  lng         Float?
  hasActivity Boolean   @default(false)
  equipments  String?   @db.Text
  rules       String?   @db.Text
  rating      Float     @default(0)
  totalReviews Int      @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id])
  photos        VenuePhoto[]
  availabilities Availability[]
  reservations  Reservation[]

  @@map("venues")
}

model VenuePhoto {
  id        Int      @id @default(autoincrement())
  venueId   Int
  url       String
  publicId  String
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_photos")
}

model Service {
  id          Int      @id @default(autoincrement())
  providerId  Int
  name        String
  category    String
  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2)
  rating      Float    @default(0)
  totalReviews Int     @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider             User                  @relation(fields: [providerId], references: [id])
  photos               ServicePhoto[]
  reservationServices  ReservationService[]

  @@map("services")
}

model ServicePhoto {
  id        Int      @id @default(autoincrement())
  serviceId Int
  url       String
  publicId  String
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_photos")
}

model Availability {
  id         Int      @id @default(autoincrement())
  venueId    Int
  date       DateTime @db.Date
  isBlocked  Boolean  @default(false)
  reason     String?
  createdAt  DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, date])
  @@map("availabilities")
}

model Reservation {
  id          Int               @id @default(autoincrement())
  clientId    Int
  venueId     Int
  startAt     DateTime
  endAt       DateTime
  guestCount  Int
  totalAmount Decimal           @db.Decimal(10, 2)
  deposit     Decimal           @db.Decimal(10, 2)  @default(0)
  status      ReservationStatus @default(EN_ATTENTE)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  client              User                 @relation(fields: [clientId], references: [id])
  venue               Venue                @relation(fields: [venueId], references: [id])
  reservationServices ReservationService[]
  payments            Payment[]
  review              Review?
  messages            Message[]

  @@map("reservations")
}

model ReservationService {
  id            Int     @id @default(autoincrement())
  reservationId Int
  serviceId     Int
  price         Decimal @db.Decimal(10, 2)
  quantity      Int     @default(1)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@unique([reservationId, serviceId])
  @@map("reservation_services")
}

model Payment {
  id            Int           @id @default(autoincrement())
  reservationId Int
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(EN_ATTENTE)
  reference     String?       @unique
  providerRef   String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("payments")
}

model Review {
  id            Int      @id @default(autoincrement())
  authorId      Int
  reservationId Int      @unique
  rating        Int
  comment       String   @db.Text
  providerReply String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author      User        @relation(fields: [authorId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("reviews")
}

model Message {
  id            Int      @id @default(autoincrement())
  senderId      Int
  receiverId    Int
  reservationId Int
  content       String   @db.Text
  attachmentUrl String?
  isRead        Boolean  @default(false)
  sentAt        DateTime @default(now())

  sender      User        @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User        @relation("ReceivedMessages", fields: [receiverId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("messages")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  content   String           @db.Text
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}